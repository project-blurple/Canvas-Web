generator client {
  provider            = "prisma-client"
  output              = "../generated"
  moduleFormat        = "cjs"
  engineType          = "client"
  importFileExtension = ""
}

datasource db {
  provider = "sqlite"
}

model SnapshotManifest {
  id                    Int      @id @default(autoincrement())
  canvasId              Int      @map("canvas_id")
  snapshotAt            DateTime @map("snapshot_at")
  historyCount          Int      @default(0) @map("history_count")
  lastIncludedHistoryAt DateTime @map("last_included_history_at")
  imagePath             String   @map("image_path")
  fileSizeBytes         Int?     @map("file_size_bytes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([canvasId, snapshotAt])
  @@map("snapshot_manifest")
}

model SnapshotCursor {
  canvasId               Int       @id @map("canvas_id")
  lastProcessedTimestamp DateTime  @default(now()) @map("last_processed_timestamp")
  dirtyFromTimestamp     DateTime? @map("dirty_from_timestamp")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("snapshot_cursor")
}

model TimelapseManifest {
  id               Int       @id @default(autoincrement())
  canvasId         Int       @map("canvas_id")
  requestedStartAt DateTime? @map("requested_start_at")
  requestedEndAt   DateTime? @map("requested_end_at")
  effectiveStartAt DateTime  @map("effective_start_at")
  effectiveEndAt   DateTime  @map("effective_end_at")
  boundsX0         Int?      @map("bounds_x0")
  boundsY0         Int?      @map("bounds_y0")
  boundsX1         Int?      @map("bounds_x1")
  boundsY1         Int?      @map("bounds_y1")
  scale            Int
  frameRate        Int       @map("frame_rate")
  endHoldDurationMs Int      @map("end_hold_duration_ms")
  showEndCard      Boolean   @default(true) @map("show_end_card")
  backgroundColor  String    @map("background_color")
  cacheKey         String    @unique @map("cache_key")
  filePath         String    @map("file_path")
  fileSizeBytes    Int?      @map("file_size_bytes")
  invalidatedAt    DateTime? @map("invalidated_at")
  accessedAt       DateTime? @map("accessed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([canvasId, effectiveStartAt, effectiveEndAt])
  @@map("timelapse_manifest")
}
