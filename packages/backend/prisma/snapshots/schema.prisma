generator client_snapshot {
  provider            = "prisma-client"
  output              = "../../src/client/snapshots/generated"
  moduleFormat        = "cjs"
  engineType          = "client"
  importFileExtension = ""
}

datasource db_snapshot {
  provider = "sqlite"
}

model snapshot_manifest {
  id                       Int      @id @default(autoincrement())
  canvas_id                Int
  snapshot_at              DateTime
  history_count            Int      @default(0)
  last_included_history_at DateTime
  image_path               String
  file_size_bytes          Int?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@unique([canvas_id, snapshot_at])
  @@index([canvas_id, snapshot_at])
}

model snapshot_cursor {
  canvas_id                Int       @id
  last_processed_timestamp DateTime  @default(now())
  dirty_from_timestamp     DateTime?
  updated_at               DateTime  @updatedAt
}

model timelapse_manifest {
  id                   Int       @id @default(autoincrement())
  canvas_id            Int
  requested_start_at   DateTime?
  requested_end_at     DateTime?
  effective_start_at   DateTime
  effective_end_at     DateTime
  bounds_x0            Int?
  bounds_y0            Int?
  bounds_x1            Int?
  bounds_y1            Int?
  scale                Int
  frame_rate           Int
  end_hold_duration_ms Int
  show_end_card        Boolean   @default(true)
  background_color     String
  cache_key            String    @unique
  file_path            String
  file_size_bytes      Int?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([canvas_id, effective_start_at, effective_end_at])
}
