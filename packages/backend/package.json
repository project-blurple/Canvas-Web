{
  "name": "@blurple-canvas-web/backend",
  "description": "API server for Blurple Canvas",
  "version": "0.1.0",
  "private": true,
  "contributors": [
    "Aaron Guo <aaronjoshguo@gmail.com>",
    "Emily Zou <yzou415@aucklanduni.ac.nz>",
    "Henry Wang <hwan513@aucklanduni.ac.nz> (http://henryh.wang)",
    "Jasper Lai <klai866@aucklanduni.ac.nz> (https://lai.nz)",
    "Josh Jeffers <joshjeffers600@gmail.com> (https://pumbas.net)",
    "Samuel Ou <me@sjou.dev> (https://sjou.dev)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/project-blurple/Canvas-Web.git",
    "directory": "packages/backend"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": {
    "url": "https://github.com/project-blurple/Canvas-Web/issues"
  },
  "engines": {
    "node": ">=25",
    "pnpm": ">=10.33.0"
  },
  "main": "build/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.json",
    "dev": "nodemon src/index.ts --devmode",
    "start": "node build/index.js",
    "postinstall": "prisma generate && prisma generate --config prisma/snapshots/prisma.config.ts",
    "test": "vitest",
    "format": "prettier --check --cache . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write --cache . --ignore-path ../../.gitignore",
    "lint": "biome check --formatter-enabled=false .",
    "lint:fix": "biome check --formatter-enabled=false --write .",
    "check": "pnpm run format && pnpm run lint",
    "check:fix": "pnpm run format:fix && pnpm run lint:fix",
    "clean": "rm -rf -- build/ && pnpm purge",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed --",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:snapshots:generate": "prisma generate --config prisma/snapshots/prisma.config.ts",
    "prisma:snapshots:migrate:dev": "prisma migrate dev --config prisma/snapshots/prisma.config.ts",
    "prisma:snapshots:migrate:deploy": "prisma migrate deploy --config prisma/snapshots/prisma.config.ts",
    "prisma:snapshots:studio": "prisma studio --config prisma/snapshots/prisma.config.ts",
    "db:resequence": "dotenvx run -f .env -- node scripts/resequence.mjs",
    "db:repair-canvas": "dotenvx run -f .env -- node scripts/repair-canvas.mjs"
  },
  "dependencies": {
    "@blurple-canvas-web/types": "workspace:*",
    "@dotenvx/dotenvx": "^1.61.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/instrumentation": "^7.7.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@quixo3/prisma-session-store": "^3.1.19",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "discord-strategy": "^2.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "kysely": "^0.29.2",
    "passport": "^0.7.0",
    "passport-oauth2-refresh": "^2.2.0",
    "prisma-extension-kysely": "^4.0.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.1.0",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/supertest": "^7.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prisma": "^7.7.0",
    "prisma-kysely": "^3.1.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.5",
    "vitest-environment-prisma-postgres": "^1.0.1"
  }
}
